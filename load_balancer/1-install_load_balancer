#!/usr/bin/env bash
# Installs HAProxy and load balances traffic between web-01 and web-02 using roundrobin
apt-get -y update
apt-get -y install haproxy

if ! grep -q "^ENABLED=1" /etc/default/haproxy; then
    echo "ENABLED=1" >> /etc/default/haproxy
fi

cat > /etc/haproxy/haproxy.cfg << 'EOF'
global
    log 127.0.0.1 local0 notice
    maxconn 2000
    user haproxy
    group haproxy

defaults
    log global
    mode http
    option httplog
    option dontlognull
    retries 3
    option redispatch
    timeout connect 5000
    timeout client 10000
    timeout server 10000

listen web-backend
    bind *:80
    balance roundrobin
    option forwardfor
    server 7429-web-01 35.179.132.8:80 check
    server 7429-web-02 18.130.180.117:80 check
EOF

service haproxy restart
