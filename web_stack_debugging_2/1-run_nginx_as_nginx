#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on port 8080
id nginx &> /dev/null || useradd -r nginx
sed -i 's/^user .*;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /; s/listen \[::\]:80 /listen [::]:8080 /' /etc/nginx/sites-available/default
chmod 644 /etc/nginx/nginx.conf
pkill apache2
service nginx stop
service nginx start
